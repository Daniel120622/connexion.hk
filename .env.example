# Copy this file to .env (or .env.local) and fill in real values.
# .env/.env.local are gitignored -- never commit real secrets.

# Required: create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# The "from" address the contact form sends as. Resend's shared sandbox
# sender (onboarding@resend.dev) only delivers to the Resend account
# owner's own inbox -- it will NOT reliably reach a real address like
# sales@connexions.hk in production.
#
# To fix this for real:
#   1. In the Resend dashboard, add and verify a domain you control
#      (e.g. connexions.hk) -- this means adding the DNS records Resend
#      gives you (SPF/DKIM) at your domain registrar.
#   2. Once verified, set this to an address on that domain, e.g.:
#      CONTACT_FROM_EMAIL=Connexions HK <contact@connexions.hk>
CONTACT_FROM_EMAIL=Connexions HK <onboarding@resend.dev>

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=sales@connexions.hk
